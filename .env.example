# Environment: true = production, false = development
VITE_PRODUCTION=false

# Backend API URL
# Dev: /api (uses Vite proxy)
# Prod: https://your-be-aws-url.com/api
VITE_API_BASE=/api

# Chat API URL  
# Dev: /api/chat (uses Vite proxy)
# Prod: https://your-bechat-aws-url.com/api/chat
VITE_CHAT_API=/api/chat
